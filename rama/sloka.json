 "lines": [
  {
   "te": "శ్రీ రామ రామ రామేతి",
   "tr": "Sri Rama Rama Rameti",
   "mean_te": "\"శ్రీ రామ, రామ, రామ\" అని జపిస్తూ",
   "mean_en": "Chanting \"Sri Rama, Rama, Rama\""
  },
  {
   "te": "రమే రామే మనోరమే",
   "tr": "Rame Rame Manorame",
   "mean_te": "మనసుకు ఆనందం ఇచ్చే రాముడిలో నేను సంతోషిస్తాను",
   "mean_en": "I rejoice in Rama, who fills the heart with joy"
  },
  {
   "te": "సహస్రనామ తత్తుల్యం",
   "tr": "Sahasranama Tattulyam",
   "mean_te": "విష్ణువు వెయ్యి పేర్లు చదివినంత పుణ్యం",
   "mean_en": "Equal to all the thousand names of Vishnu"
  },
  {
   "te": "రామనామ వరాననే",
   "tr": "Rama Nama Varanane",
   "mean_te": "ఒక్క రామ నామంతోనే వస్తుంది, ఓ పార్వతీ!",
   "mean_en": "comes from the one name \"Rama\", O Parvati!"
  }
 ],
