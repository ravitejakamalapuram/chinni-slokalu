 "lines": [
  {
   "te": "వసుదేవ సుతం దేవం",
   "tr": "Vasudeva Sutam Devam",
   "mean_te": "వసుదేవుడి ముద్దుల కొడుకు, మన దేవుడు",
   "mean_en": "The divine son of Vasudeva"
  },
  {
   "te": "కంస చాణూర మర్దనమ్",
   "tr": "Kamsa Chanura Mardanam",
   "mean_te": "చెడ్డ రాజు కంసుడిని, మల్లుడు చాణూరుడిని ఓడించినవాడు",
   "mean_en": "Who defeated wicked Kamsa and the wrestler Chanura"
  },
  {
   "te": "దేవకీ పరమానందం",
   "tr": "Devaki Paramanandam",
   "mean_te": "దేవకీ అమ్మకు ఎంతో ఎంతో ఆనందం ఇచ్చినవాడు",
   "mean_en": "The greatest joy of mother Devaki"
  },
  {
   "te": "కృష్ణం వందే జగద్గురుమ్",
   "tr": "Krishnam Vande Jagadgurum",
   "mean_te": "లోకానికే గురువైన కృష్ణయ్యకు నమస్కారం",
   "mean_en": "I bow to Krishna, teacher of the whole world"
  }
 ],
