 "title_top": "LET'S LEARN",
 "title_main": "MAHALAKSHMI!",
 "title_te": "మహాలక్ష్మి శ్లోకం",
 "hero_label": "LAKSHMI",
 "lines": [
  {
   "te": "నమస్తేఽస్తు మహామాయే",
   "say": "నమస్తేస్తు... మహామాయే",
   "tr": "Namaste'stu Mahamaaye",
   "mean_te": "అద్భుతమైన శక్తి గల అమ్మా, నీకు నమస్కారం",
   "mean_en": "Salutations to you, Mother of wondrous divine power"
  },
  {
   "te": "శ్రీపీఠే సురపూజితే",
   "say": "శ్రీపీఠే... సురపూజితే",
   "tr": "Shree Peethe Sura Poojite",
   "mean_te": "శ్రీ పీఠం మీద కూర్చునే అమ్మా, దేవతలందరూ నిన్ను పూజిస్తారు",
   "mean_en": "You sit on the holy throne, and all the gods worship you"
  },
  {
   "te": "శంఖ చక్ర గదా హస్తే",
   "say": "శంఖ... చక్ర... గదా... హస్తే",
   "tr": "Shankha Chakra Gadaa Haste",
   "mean_te": "చేతుల్లో శంఖం, చక్రం, గద పట్టుకున్న అమ్మా",
   "mean_en": "You hold the conch, the discus and the mace"
  },
  {
   "te": "మహాలక్ష్మి నమోఽస్తు తే",
   "say": "మహాలక్ష్మి... నమోస్తు తే",
   "tr": "Mahalakshmi Namo'stu Te",
   "mean_te": "ఓ మహాలక్ష్మీ, నీకు మా నమస్కారం",
   "mean_en": "O Mahalakshmi, we bow to you"
  }
 ],
