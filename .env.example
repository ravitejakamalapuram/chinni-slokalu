# Copy to .env (never commit it) and `set -a; . ./.env; set +a` before ./reel upload or voice generation.
INBOX_URL=            # the Inbox web app /exec URL (API deployment)
INBOX_TOKEN=          # an Inbox token made with createToken
DRIVE_REELS_FOLDER=   # Drive folder id for finished reels and covers (chittiSlokalu/Reels); must be inside the Inbox UPLOAD_ROOTS
GEMINI_API_KEY=       # only for making new voice clips (Gemini TTS: Leda). Not needed to rebuild existing reels.
ELEVENLABS_API_KEY=   # only for new sung finales (ElevenLabs Music). Not needed to rebuild existing reels.
