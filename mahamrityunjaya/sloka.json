 "title_top": "LET'S LEARN",
 "title_main": "MAHA MRITYUNJAYA!",
 "title_te": "మహా మృత్యుంజయ మంత్రం",
 "hero_label": "SHIVA",
 "lines": [
  {
   "te": "ఓం త్ర్యంబకం యజామహే",
   "tr": "Om Tryambakam Yajamahe",
   "mean_te": "మూడు కన్నుల శివయ్యను మనం పూజిస్తాం",
   "mean_en": "We worship the three-eyed Lord Shiva"
  },
  {
   "te": "సుగంధిం పుష్టివర్ధనమ్",
   "tr": "Sugandhim Pushtivardhanam",
   "mean_te": "మంచి సువాసన గలవాడు, అందరికీ బలం, పోషణ ఇచ్చేవాడు",
   "mean_en": "Fragrant one, who nourishes all and makes us grow strong"
  },
  {
   "te": "ఉర్వారుకమివ బంధనాన్",
   "tr": "Urvarukamiva Bandhanan",
   "mean_te": "పండిన దోసకాయ తీగ నుండి సులువుగా విడిపోయినట్లు",
   "mean_en": "Like a ripe cucumber gently freed from its vine"
  },
  {
   "te": "మృత్యోర్ముక్షీయ మామృతాత్",
   "tr": "Mrityor Mukshiya Maamritat",
   "mean_te": "మమ్మల్ని భయం, మృత్యువు నుండి విడిపించి, అమృతం లాంటి ఆనందం ఇవ్వు",
   "mean_en": "Free us from fear and death, and give us the nectar of joy"
  }
 ],
