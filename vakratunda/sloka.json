{
 "id": "vakratunda",
 "title_top": "LET'S LEARN",
 "title_main": "GANESHA SLOKA!",
 "title_te": "గణపతి శ్లోకం",
 "hero_label": "GANESHA",
 "lines": [
  {
   "te": "వక్రతుండ మహాకాయ",
   "tr": "Vakratunda Mahakaya",
   "mean_te": "వంకర తొండం, పెద్ద శరీరం ఉన్న గణపయ్యా!",
   "mean_en": "O Ganesha, with a curved trunk and a big, mighty body"
  },
  {
   "te": "సూర్యకోటి సమప్రభ",
   "tr": "Suryakoti Samaprabha",
   "mean_te": "కోటి సూర్యుల వెలుగుతో మెరిసేవాడా!",
   "mean_en": "You shine as bright as a crore suns"
  },
  {
   "te": "నిర్విఘ్నం కురు మే దేవ",
   "tr": "Nirvighnam Kuru Me Deva",
   "mean_te": "దేవా, నాకు ఏ ఆటంకాలూ రాకుండా చూడు!",
   "mean_en": "O God, please remove all obstacles for me"
  },
  {
   "te": "సర్వకార్యేషు సర్వదా",
   "tr": "Sarvakaryeshu Sarvada",
   "mean_te": "నేను చేసే అన్ని పనులలో, ఎప్పుడూ!",
   "mean_en": "In everything I do, always"
  }
 ],
