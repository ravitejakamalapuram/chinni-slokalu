 "lines": [
  {
   "te": "బ్రహ్మార్పణం బ్రహ్మ హవిః",
   "tr": "Brahmarpanam Brahma Havih",
   "mean_te": "మనం అర్పించేది దేవుడే, మనం తినే అన్నం కూడా దేవుడే",
   "mean_en": "The offering is God, and the food we eat is God too"
  },
  {
   "te": "బ్రహ్మాగ్నౌ బ్రహ్మణా హుతమ్",
   "tr": "Brahmagnau Brahmana Hutam",
   "mean_te": "మన కడుపులోని అగ్ని దేవుడే, తినేది కూడా దేవుడే",
   "mean_en": "The fire in our tummy is God, and the one who eats is God"
  },
  {
   "te": "బ్రహ్మైవ తేన గంతవ్యం",
   "tr": "Brahmaiva Tena Gantavyam",
   "mean_te": "అలా అనుకునేవారు దేవుడినే చేరుకుంటారు",
   "mean_en": "Whoever thinks like this, reaches God"
  },
  {
   "te": "బ్రహ్మకర్మ సమాధినా",
   "tr": "Brahma Karma Samadhina",
   "mean_te": "ప్రతి పనిలోనూ దేవుడినే చూస్తూ ఉంటే",
   "mean_en": "by seeing God in every work they do"
  }
 ],
