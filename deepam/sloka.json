 "lines": [
  {
   "te": "దీపజ్యోతి పరబ్రహ్మ",
   "tr": "Deepa Jyoti Parabrahma",
   "mean_te": "దీపపు వెలుగే ఆ పరమాత్మ",
   "mean_en": "The light of the lamp is the Supreme God"
