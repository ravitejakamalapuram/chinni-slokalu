  {
   "te": "దీపజ్యోతి జనార్దన",
   "tr": "Deepa Jyoti Janardhana",
   "mean_te": "దీపపు వెలుగే జనార్దనుడు, మన విష్ణుమూర్తి",
   "mean_en": "The light of the lamp is Lord Vishnu (Janardhana)"
  },
  {
   "te": "దీపో హరతు మే పాపం",
   "tr": "Deepo Haratu Me Paapam",
   "mean_te": "ఈ దీపం నాలోని చెడును పోగొట్టుగాక",
   "mean_en": "May this lamp take away all that is bad in me"
  },
  {
   "te": "దీపజ్యోతి నమోస్తుతే",
   "tr": "Deepa Jyoti Namostute",
   "mean_te": "ఓ దీపజ్యోతీ, నీకు నమస్కారం!",
   "mean_en": "O light of the lamp, I bow to you"
  }
