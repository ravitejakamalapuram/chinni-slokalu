 "lines": [
  {
   "te": "ఓం అసతో మా సద్గమయ",
   "tr": "Om Asato Maa Sadgamaya",
   "mean_te": "అబద్ధం నుండి నిజం వైపు నన్ను నడిపించు",
   "mean_en": "Lead me from untruth to truth"
  },
  {
   "te": "తమసో మా జ్యోతిర్గమయ",
   "tr": "Tamaso Maa Jyotirgamaya",
   "mean_te": "చీకటి నుండి వెలుగు వైపు నన్ను నడిపించు",
   "mean_en": "Lead me from darkness to light"
  },
  {
   "te": "మృత్యోర్మా అమృతం గమయ",
   "tr": "Mrityor Maa Amritam Gamaya",
   "mean_te": "మరణం నుండి అమరత్వం వైపు నన్ను నడిపించు",
   "mean_en": "Lead me from death to immortality"
  },
  {
   "te": "ఓం శాంతిః శాంతిః శాంతిః",
   "tr": "Om Shantih Shantih Shantih",
   "mean_te": "అంతటా శాంతి కలుగుగాక",
   "mean_en": "Peace, peace, peace everywhere"
  }
 ],
