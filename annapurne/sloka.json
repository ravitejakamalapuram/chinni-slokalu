 "hero_label": "FOOD FOR ALL",
 "lines": [
  {
   "te": "అన్నపూర్ణే సదాపూర్ణే",
   "tr": "Annapurne Sadapurne",
   "mean_te": "ఓ అన్నపూర్ణమ్మా, నీ దగ్గర అన్నం ఎప్పుడూ నిండుగా ఉంటుంది",
   "mean_en": "O Annapurna, your pot of food is always full"
  },
  {
   "te": "శంకర ప్రాణవల్లభే",
   "tr": "Shankara Pranavallabhe",
   "mean_te": "నువ్వు శివయ్యకు ప్రాణం కంటే ప్రియమైనదానివి",
   "mean_en": "You are dearer than life to Lord Shiva"
  },
  {
   "te": "జ్ఞాన వైరాగ్య సిద్ధ్యర్థం",
   "tr": "Jnana Vairagya Siddhyartham",
   "mean_te": "మాకు జ్ఞానం రావాలి, అత్యాశ పోవాలి",
   "mean_en": "So we grow wise and free from greed"
  },
  {
   "te": "భిక్షాం దేహి చ పార్వతి",
   "tr": "Bhiksham Dehi Cha Parvati",
   "mean_te": "ఓ పార్వతీ, మాకు అన్నం పెట్టు తల్లీ",
   "mean_en": "O Parvati, please give us food"
  }
 ],
