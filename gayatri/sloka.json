 "lines": [
  {
   "te": "ఓం భూర్భువః స్వః",
   "tr": "Om Bhur Bhuvah Svah",
   "mean_te": "భూమి, ఆకాశం, స్వర్గం, అన్నిచోట్లా ఉన్న దేవుడా!",
   "mean_en": "O God, present in the earth, the sky and the heavens"
  },
  {
   "te": "తత్సవితుర్వరేణ్యం",
   "tr": "Tat Savitur Varenyam",
   "mean_te": "ఎంతో గొప్పవాడైన ఆ సూర్య దేవుడి",
   "mean_en": "Of that most adorable Sun God"
  },
  {
   "te": "భర్గో దేవస్య ధీమహి",
   "tr": "Bhargo Devasya Dhimahi",
   "mean_te": "దివ్యమైన వెలుగును మనం ధ్యానిద్దాం",
   "mean_en": "We meditate on that divine light"
  },
  {
   "te": "ధియో యో నః ప్రచోదయాత్",
   "tr": "Dhiyo Yo Nah Prachodayat",
   "mean_te": "ఆ దేవుడు మా బుద్ధిని మంచి దారిలో నడిపించుగాక!",
   "mean_en": "May He guide our minds on the right path"
  }
 ],
