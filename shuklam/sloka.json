  {
   "te": "శుక్లాంబరధరం విష్ణుం",
   "tr": "Shuklambaradharam Vishnum",
   "mean_te": "తెల్లని వస్త్రాలు ధరించి, అంతటా నిండి ఉన్న దేవుడు",
   "mean_en": "Dressed in white, he is everywhere"
  },
  {
   "te": "శశివర్ణం చతుర్భుజమ్",
   "tr": "Shashivarnam Chaturbhujam",
   "mean_te": "చంద్రుడిలా వెలిగే, నాలుగు చేతుల దేవుడు",
   "mean_en": "Bright as the moon, with four arms"
  },
  {
   "te": "ప్రసన్నవదనం ధ్యాయేత్",
   "tr": "Prasannavadanam Dhyayet",
   "mean_te": "నవ్వుతున్న ఆయన ముఖాన్ని ధ్యానిద్దాం",
   "mean_en": "Think of his smiling face"
  },
  {
   "te": "సర్వవిఘ్నోపశాంతయే",
   "tr": "Sarvavighnopashantaye",
   "mean_te": "అన్ని అడ్డంకులు తొలగిపోవడానికి",
   "mean_en": "So that every obstacle goes away"
  }
 ],
