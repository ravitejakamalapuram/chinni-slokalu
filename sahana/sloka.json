 "lines": [
  {
   "te": "ఓం సహ నావవతు సహ నౌ భునక్తు",
   "tr": "Om Saha Navavatu Saha Nau Bhunaktu",
   "mean_te": "దేవుడు గురువునీ శిష్యుడినీ కలిసి కాపాడాలి, కలిసి పోషించాలి",
   "mean_en": "May God protect us both, and nourish us both together",
   "rows": [
    "ఓం సహ నావవతు",
    "సహ నౌ భునక్తు"
   ]
  },
  {
   "te": "సహ వీర్యం కరవావహై",
   "tr": "Saha Veeryam Karavavahai",
   "mean_te": "మనం ఇద్దరం కలిసి బలంగా, ఉత్సాహంగా పని చేద్దాం",
   "mean_en": "May we work together with strength and energy"
  },
  {
   "te": "తేజస్వి నావధీతమస్తు",
   "tr": "Tejasvi Navadhitamastu",
   "mean_te": "మనం కలిసి చదివే చదువు వెలుగులా ప్రకాశించాలి",
   "mean_en": "May what we learn together shine bright"
  },
  {
   "te": "మా విద్విషావహై ఓం శాంతిః శాంతిః శాంతిః",
   "tr": "Ma Vidvishavahai, Om Shantih Shantih Shantih",
   "mean_te": "మనం ఎప్పుడూ ఒకరినొకరు ద్వేషించుకోకూడదు. అంతటా శాంతి!",
   "mean_en": "May we never dislike each other. Peace, peace, peace!",
   "rows": [
    "మా విద్విషావహై",
    "ఓం శాంతిః శాంతిః శాంతిః"
   ]
  }
 ],
