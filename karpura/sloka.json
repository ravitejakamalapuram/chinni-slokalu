 "lines": [
  {
   "te": "కర్పూరగౌరం కరుణావతారం",
   "tr": "Karpura Gauram Karunavataram",
   "mean_te": "కర్పూరంలా తెల్లగా మెరిసేవాడు, దయకు రూపమైనవాడు",
   "mean_en": "Fair as camphor, compassion in person"
  },
  {
   "te": "సంసారసారం భుజగేంద్రహారమ్",
   "tr": "Samsara Saaram Bhujagendra Haaram",
   "mean_te": "లోకానికంతటికీ సారమైనవాడు, నాగరాజును హారంగా వేసుకున్నవాడు",
   "mean_en": "The essence of the world, wearing the king of snakes as a garland"
  },
  {
   "te": "సదా వసంతం హృదయారవిందే",
   "tr": "Sadaa Vasantam Hridayaravinde",
   "mean_te": "ఎప్పుడూ మన హృదయ కమలంలో ఉండేవాడు",
   "mean_en": "He always lives in the lotus of our heart"
  },
  {
   "te": "భవం భవానీసహితం నమామి",
   "tr": "Bhavam Bhavani Sahitam Namaami",
   "mean_te": "పార్వతీ దేవితో కలిసి ఉన్న శివయ్యకు నమస్కారం",
   "mean_en": "I bow to Shiva, together with Mother Parvati"
  }
 ],
